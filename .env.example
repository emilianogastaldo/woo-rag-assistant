# =============================================================
# woo-rag-assistant — template variabili d'ambiente
# Copiare in `.env` e valorizzare. NON committare mai `.env`.
# =============================================================

# --- LLM provider (OpenAI) ---
OPENAI_API_KEY=
# Modello per generazione e routing
OPENAI_MODEL=gpt-4.1-mini
# Modello per gli embedding del RAG
EMBEDDING_MODEL=text-embedding-3-small
# Endpoint OpenAI-compatible opzionale (vuoto = endpoint OpenAI ufficiale)
OPENAI_BASE_URL=
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_RETRY_ATTEMPTS=1

# --- Document parsing (LlamaParse / LlamaCloud) ---
LLAMA_CLOUD_API_KEY=

# --- WooCommerce REST API (chiavi READ-ONLY) ---
# In locale il backend raggiunge WooCommerce via nome servizio Docker.
WC_BASE_URL=http://wordpress/wp-json/wc/v3
# URL pubblico (home_url di WordPress) per la firma OAuth: WooCommerce ricostruisce
# la firma dal proprio home_url, non dall'host di connessione. Se vuoto usa WC_BASE_URL.
WC_SIGN_URL=http://localhost:8080/wp-json/wc/v3
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_TIMEOUT_SECONDS=5
WC_RETRY_ATTEMPTS=1

# --- ChromaDB (vector store) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=woo_knowledge

# --- Retrieval (hybrid e retry sono opt-in, da calibrare con embedding reali) ---
RETRIEVAL_STRATEGY=semantic
RETRIEVAL_K=4
RETRIEVAL_CANDIDATES=12
RETRIEVAL_MAX_DISTANCE=0.6
RETRIEVAL_RRF_CONSTANT=60
RETRIEVAL_SEMANTIC_WEIGHT=1.0
RETRIEVAL_LEXICAL_WEIGHT=1.0
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75
RETRIEVAL_LEXICAL_MIN_SCORE=1.0
RETRIEVAL_LEXICAL_MIN_COVERAGE=1.0
RETRIEVAL_RETRY_ATTEMPTS=0

# --- Robustezza agente: budget condiviso fra retry retrieval/HTTP/provider ---
AGENT_MAX_STEPS=4
AGENT_MAX_ATTEMPTS=12
AGENT_RETRY_BUDGET=2
AGENT_MAX_REPEATED_ERRORS=2
REQUEST_DEADLINE_SECONDS=30

# --- Sessione / auth ---
# Segreto per firmare/validare i token di sessione lato server.
SESSION_SECRET=change-me-in-production

# --- Widget ---
# Origini ammesse dal CORS del backend (dove è incorporato il widget).
CORS_ORIGINS=http://localhost:8080,http://localhost:8000
