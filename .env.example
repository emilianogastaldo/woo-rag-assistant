# =============================================================
# woo-rag-assistant — template variabili d'ambiente
# Copiare in `.env` e valorizzare. NON committare mai `.env`.
# =============================================================

# --- LLM provider (OpenAI) ---
OPENAI_API_KEY=
# Modello per generazione e routing
OPENAI_MODEL=gpt-4.1-mini
# Modello per gli embedding del RAG
EMBEDDING_MODEL=text-embedding-3-small

# --- Document parsing (LlamaParse / LlamaCloud) ---
LLAMA_CLOUD_API_KEY=

# --- WooCommerce REST API (chiavi READ-ONLY) ---
# In locale il backend raggiunge WooCommerce via nome servizio Docker.
WC_BASE_URL=http://wordpress/wp-json/wc/v3
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- ChromaDB (vector store) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=woo_knowledge

# --- Sessione / auth ---
# Segreto per firmare/validare i token di sessione lato server.
SESSION_SECRET=change-me-in-production
