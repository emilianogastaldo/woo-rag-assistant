[Unit]
Description=Refresh the single-store Woo RAG knowledge snapshot
Requires=docker.service
After=docker.service
# Operator installs this unit only after authorizing the corpus and provider usage.

[Service]
Type=oneshot
WorkingDirectory=/opt/woo-rag-assistant
ExecStart=/usr/bin/docker compose run --rm -T --no-deps ingest python -m app.ingest build
TimeoutStartSec=15min
